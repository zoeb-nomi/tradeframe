{
  "id": "{{WF_FILL_INGEST_ID}}",
  "name": "Trading OS v3 — IndMoney Fill Ingest",
  "active": true,
  "settings": { "executionOrder": "v1", "availableInMCP": true, "timezone": "Asia/Kolkata", "errorWorkflow": "{{WF_FAILURE_MONITOR_ID}}" },
  "connections": {
    "IndMoney Order Emails (poll 15m)": { "main": [[{ "node": "Drop SIP Emails", "type": "main", "index": 0 }]] },
    "Drop SIP Emails": { "main": [[{ "node": "Parse IndMoney Email", "type": "main", "index": 0 }]] },
    "Parse IndMoney Email": { "main": [[{ "node": "Dedup (skip seen gmail_message_id)", "type": "main", "index": 0 }]] },
    "Dedup (skip seen gmail_message_id)": { "main": [[{ "node": "Insert trade_ledger Row", "type": "main", "index": 0 }]] },
    "Insert trade_ledger Row": { "main": [[{ "node": "Needs Telegram Alert?", "type": "main", "index": 0 }]] },
    "Needs Telegram Alert?": { "main": [[{ "node": "Send Telegram Alert", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    { "name": "IndMoney Order Emails (poll 15m)", "type": "n8n-nodes-base.gmailTrigger", "typeVersion": 1.4, "position": [-1180, 300], "parameters": { "pollTimes": { "item": [{ "mode": "everyX", "value": 15, "unit": "minutes" }] }, "simple": false, "filters": { "sender": "transactions@transactions.indmoney.com", "readStatus": "both", "q": "-subject:SIP" }, "options": {} }, "credentials": { "gmailOAuth2": { "id": "{{CREDENTIAL_ID}}", "name": "Gmail account" } } },
    { "name": "Drop SIP Emails", "type": "n8n-nodes-base.filter", "typeVersion": 2.3, "position": [-940, 300], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "no-sip", "leftValue": "={{ $json.subject }}", "operator": { "type": "string", "operation": "notContains" }, "rightValue": "SIP" }], "combinator": "and" } } },
    { "name": "Parse IndMoney Email", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-700, 300], "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "SEE NOTE: full parser code lives in the live workflow. Classifies subject into BUY_FILL/SELL_FILL/ORDER_CANCELLED/DIVIDEND/OTHER; regex-extracts company (from the 'Ticker:' field which holds the company NAME), amount, price, shares, order_type, account from body/snippet; maps company->symbol via static MAP (direxion daily semiconductor bull->SOXL, alphabet class a->GOOGL, alphabet class c->GOOG, nvidia->NVDA, broadcom->AVGO, taiwan semiconductor->TSM, vistra->VST, ouster->OUST, micron->MU, nebius->NBIS, vertiv->VRT, marvell->MRVL, tesla->TSLA, palantir->PLTR, microsoft->MSFT; unknown->'?', row never dropped); builds IST timestamp and Telegram alert_text (STOP FILLED for stop/trigger sell fills, Order filled, Order cancelled); outputs ledger row fields + alert_needed/alert_text." } },
    { "name": "Dedup (skip seen gmail_message_id)", "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [-440, 300], "parameters": { "resource": "row", "operation": "rowNotExists", "dataTableId": { "__rl": true, "mode": "id", "value": "{{TABLE_TRADE_LEDGER_ID}}", "cachedResultName": "trade_ledger" }, "matchType": "allConditions", "filters": { "conditions": [{ "keyName": "gmail_message_id", "condition": "eq", "keyValue": "={{ $json.gmail_message_id }}" }] } } },
    { "name": "Insert trade_ledger Row", "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [-180, 300], "parameters": { "resource": "row", "operation": "insert", "dataTableId": { "__rl": true, "mode": "id", "value": "{{TABLE_TRADE_LEDGER_ID}}", "cachedResultName": "trade_ledger" }, "columns": { "mappingMode": "defineBelow", "value": { "event_ts": "={{ $json.event_ts }}", "event_type": "={{ $json.event_type }}", "ticker": "={{ $json.ticker }}", "company": "={{ $json.company }}", "shares": "={{ $json.shares }}", "price": "={{ $json.price }}", "amount": "={{ $json.amount }}", "order_type": "={{ $json.order_type }}", "account": "={{ $json.account }}", "gmail_message_id": "={{ $json.gmail_message_id }}", "raw_subject": "={{ $json.raw_subject }}", "source": "={{ $json.source }}" }, "attemptToConvertTypes": true } } },
    { "name": "Needs Telegram Alert?", "type": "n8n-nodes-base.filter", "typeVersion": 2.3, "position": [80, 300], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "id": "alert-check", "leftValue": "={{ $('Parse IndMoney Email').item.json.alert_needed }}", "operator": { "type": "boolean", "operation": "true" }, "rightValue": true }], "combinator": "and" } } },
    { "name": "Send Telegram Alert", "type": "n8n-nodes-base.telegram", "typeVersion": 1.2, "position": [340, 300], "parameters": { "resource": "message", "operation": "sendMessage", "chatId": "{{TELEGRAM_CHAT_ID}}", "text": "={{ $('Parse IndMoney Email').item.json.alert_text }}", "additionalFields": { "appendAttribution": false, "parse_mode": "HTML", "disable_web_page_preview": true } }, "credentials": { "telegramApi": { "id": "{{CREDENTIAL_ID}}", "name": "Telegram account" } } }
  ],
  "_note": "Condensed export 2026-08-11 (public API disabled; exported via MCP). Node UUIDs and full jsCode omitted for the parser node - the live workflow at your n8n instance, workflow {{WF_FILL_INGEST_ID}} is the source of truth. Credentials referenced by ID only, no secrets."
}
